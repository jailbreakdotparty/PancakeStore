set(CMAKE_SYSTEM_NAME Darwin)
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(SDK "$ENV{IOS_SDK}")
set(TRIPLE "arm64-apple-ios16.0")
set(LDWRAP "$ENV{IOS_LD}")
set(CMAKE_C_COMPILER "$ENV{SWIFTLY_BIN}/clang")
set(CMAKE_CXX_COMPILER "$ENV{SWIFTLY_BIN}/clang++")
set(CMAKE_AR "$ENV{SWIFTLY_BIN}/llvm-ar" CACHE FILEPATH "" FORCE)
set(CMAKE_RANLIB "$ENV{SWIFTLY_BIN}/llvm-ranlib" CACHE FILEPATH "" FORCE)
set(CMAKE_C_COMPILER_TARGET ${TRIPLE})
set(CMAKE_CXX_COMPILER_TARGET ${TRIPLE})
set(CMAKE_OSX_SYSROOT ${SDK})
set(_flags "--target=${TRIPLE} -isysroot ${SDK} -arch arm64")
set(CMAKE_C_FLAGS_INIT "${_flags}")
set(CMAKE_CXX_FLAGS_INIT "${_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=${LDWRAP} -Wl,-platform_version,ios,16.0,27.2")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=${LDWRAP} -Wl,-platform_version,ios,16.0,27.2")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_FIND_ROOT_PATH ${SDK})
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
